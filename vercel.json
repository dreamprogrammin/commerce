{
  "crons": [
    {
      "path": "/api/generate-alt-texts",
      "schedule": "0 0 * * 0"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^.*\\.vercel\\.app$"
        }
      ],
      "destination": "https://uhti.kz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^.*\\.vercel\\.app$"
        }
      ],
      "destination": "https://uhti.kz/:path*",
      "permanent": true
    },
    {
      "source": "/catalog/products/lego-marvel-76287-zheleznyy-chelovek-s-motociklom-i-halk-pervyy-konstruktor-dlya-detey-ot-4-let",
      "destination": "/catalog/products/konstruktor-lego-marvel-76287-zheleznyy-chelovek-na-motocikle-protiv-halka-s-razrushaemym-domom",
      "permanent": true
    },
    {
      "source": "/catalog/products/batteries-aa-4pcs",
      "destination": "/catalog/products/batareyki-soni-palchikovye-solevye-tip-aa-15v-4-sht-v-upakovke-dlya-rc-igrushek",
      "permanent": true
    },
    {
      "source": "/catalog/products/batteries-aaa-2pcs",
      "destination": "/catalog/accessories/batteries",
      "permanent": true
    },
    {
      "source": "/catalog/products/radioupravlyaemaya-mashina-vnedorozhnik-2172-masshtab-1-16-so-zvukom-i-svetom-off-road-s-usb-zaryadkoy",
      "destination": "/catalog/boys/mashinki/radioupravlyaemye-mashinki",
      "permanent": true
    },
    {
      "source": "/catalog/:path((?!.*/brand/).*)",
      "has": [
        {
          "type": "query",
          "key": "brand",
          "value": "(?<brandSlug>.*)"
        }
      ],
      "destination": "/catalog/:path/brand/:brandSlug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_nuxt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon-:size.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/android-chrome-:size.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/:file*.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/:file*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
