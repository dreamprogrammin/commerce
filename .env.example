# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Секретный ключ Supabase (обходит RLS — только сервер и локальные скрипты).
# Где взять: дашборд → Project Settings → API Keys → secret / service_role.
# Проверить, что рабочий:
#   curl -s -o /dev/null -w "%{http_code}\n" \
#     "$SUPABASE_URL/rest/v1/orders?select=id&limit=1" \
#     -H "apikey: $SUPABASE_SERVICE_KEY" -H "Authorization: Bearer $SUPABASE_SERVICE_KEY"
# 200 — годен; 401 «Invalid API key» — ротирован или из другого проекта.
SUPABASE_SERVICE_KEY=your-service-role-key

# Realtime Configuration
# Set to 'true' to disable Realtime (useful if Realtime is not enabled in Supabase project)
NUXT_PUBLIC_DISABLE_REALTIME=false

# IndexNow Key (for search engine indexing)
INDEXNOW_KEY=your-indexnow-key

# ============================================================================
# SEO-аудит. Всё ниже нужно только для проверок, приложению не требуется.
# ============================================================================

# Ключ PageSpeed Insights — лабораторные и полевые Core Web Vitals.
# Cloud-проект уже есть (e-store-454918), новый заводить не нужно:
#   1) включить «PageSpeed Insights API» в этом проекте
#   2) APIs & Services → Credentials → Create credentials → API key
# Без ключа публичная квота исчерпана: API отвечает «Quota exceeded».
PAGESPEED_API_KEY=your-pagespeed-api-key

# Google Search Console — индексация, запросы, показы, CTR, позиции.
# Сервисный аккаунт уже лежит в service-account.json (он в .gitignore)
# и авторизуется успешно: uhti-indexing-bot@e-store-454918.iam.gserviceaccount.com
# Осталось два шага, оба вне репозитория:
#   1) включить «Google Search Console API» в проекте e-store-454918
#   2) в GSC: Настройки → Пользователи и разрешения → Добавить пользователя →
#      вписать email выше, права «Полные»
GSC_SITE_URL=https://uhti.kz/
GSC_SERVICE_ACCOUNT_FILE=service-account.json
